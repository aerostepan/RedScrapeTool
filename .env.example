# Copy this file to .env and fill in your key.
OPENAI_API_KEY=

# Optional but recommended when Reddit blocks public RSS with HTTP 403.
# Create an app at https://www.reddit.com/prefs/apps and use the app credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="market-research-tool/0.1 by local-user"

# Google Sheets and Google Docs publishing.
# Save your downloaded Desktop OAuth client JSON in the ignored secrets/ folder.
GOOGLE_OAUTH_CLIENT_FILE="secrets/google_oauth_client.json"
GOOGLE_TOKEN_FILE="secrets/google_token.json"
# Optional Drive folder where generated Sheets and Docs should be stored.
GOOGLE_DRIVE_FOLDER_ID=
# Set true only if people receiving the Telegram link may view the reports by link.
GOOGLE_SHARE_WITH_LINK=false
# Optional: force an existing Google Doc to be the reusable NotebookLM source.
# If empty, the app creates and remembers one source document for each topic.
GOOGLE_NOTEBOOK_SOURCE_DOC_ID=

# Telegram bot notification publishing.
TELEGRAM_BOT_TOKEN=
# Use @channel_username for a public channel, or the numeric chat/group id.
TELEGRAM_CHAT_ID=

# Your personal NotebookLM share link. The app includes it in Telegram messages.
# Standard NotebookLM still requires manual Drive-source sync and Mind Map regeneration.
NOTEBOOKLM_NOTEBOOK_URL=
